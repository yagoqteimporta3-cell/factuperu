# Copia este archivo a `.env` y cambia los valores.
# SECRET_KEY: genera una clave larga y aleatoria. Puedes usar:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
DATABASE_URL=postgres://usuario:clave@localhost:5432/factuperu
